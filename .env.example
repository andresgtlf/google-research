# Copy to .env and fill in the keys you have. See API_KEYS.md for details.

# Gemini — extraction + Gemini Deep Research (paid tier required for Deep Research)
GOOGLE_API_KEY=

# OpenAI Deep Research (o3 / o4-mini) — optional
OPENAI_API_KEY=

# Claude Research (web search agent) — optional
ANTHROPIC_API_KEY=

# Durable directory: mount a persistent disk here in hosted environments.
LIBRARY_DIR=data/library
# Enable database candidate retrieval before model synthesis.
EVIDENCE_SEEDING=1
EVIDENCE_ENRICHMENT=1
OPENALEX_API_KEY=
OPENALEX_MAILTO=
